# ===== Django =====
DJANGO_SECRET_KEY=django-insecure-replace-this
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# ===== Database =====
# Mac dinh: SQLite (file lwb_backend.sqlite3 canh manage.py), khong can cai gi them.
DB_ENGINE=sqlite
# Muon dung PostgreSQL thi doi DB_ENGINE=postgresql va dien:
# DB_NAME=lwb_monitoring
# DB_USER=lwb_user
# DB_PASSWORD=...
# DB_HOST=127.0.0.1
# DB_PORT=5432

# ===== Chinh sach du lieu =====
LWB_ONLINE_SECONDS=30
# Xoa ban ghi cam bien cu hon N phut (giu danh sach node va ket qua do PERF)
LWB_READING_RETENTION_MINUTES=15
# 0 = giu ket qua do PERF mai mai
LWB_PERF_RETENTION_HOURS=0

# ===== Mobile API (cong 8001, chi doc, cho app Android qua Tailscale) =====
# run_windows.bat dat LWB_MOBILE_ALLOWED_HOSTS=* cho cua so "LWB mobile api"; "*" cung hop le o day.
LWB_MOBILE_ALLOWED_HOSTS=127.0.0.1,localhost,10.0.2.2,[::1]
# Dai CIDR (ngoai loopback) duoc goi Mobile API. Mac dinh la dai IP cua Tailscale.
LWB_MOBILE_ALLOWED_NETS=100.64.0.0/10

# ===== EMQX Cloud =====
MQTT_HOST=YOUR-DEPLOYMENT.emqxsl.com
MQTT_PORT=8883
MQTT_TLS=true
MQTT_USERNAME=django-backend
MQTT_PASSWORD=CHANGE_ME
MQTT_BASE_TOPIC=warehouse/site1/lwb
# Co dinh de EMQX giu phien va luu tin khi consumer tat. Khong chay 2 consumer cung ID.
MQTT_CLIENT_ID=lwb-django-consumer
# De trong tren Windows (dung kho chung chi cua he dieu hanh) hoac tro toi file emqxsl-ca.crt
MQTT_CA=
