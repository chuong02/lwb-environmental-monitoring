# ---------- Serial ----------
# Prefer /dev/serial/by-id/... on the Raspberry Pi when available.
SERIAL_PORT=/dev/ttyUSB0
SERIAL_BAUD=115200
SERIAL_TIMEOUT=1.0
SERIAL_RECONNECT_SEC=3

# ---------- Local durable storage ----------
DB_PATH=/var/lib/lwb-gateway/lwb.db
LOG_DIR=/var/log/lwb-gateway

# ---------- Gateway identity ----------
GATEWAY_ID=border-router

# ---------- EMQX Cloud Serverless ----------
MQTT_HOST=YOUR_EMQX_HOST
MQTT_PORT=8883
MQTT_TLS=true
MQTT_USERNAME=YOUR_EMQX_USERNAME
MQTT_PASSWORD=YOUR_EMQX_PASSWORD
MQTT_CA=/etc/lwb-gateway/certs/emqxsl-ca.crt

MQTT_CLIENT_ID=border-router-lwb
MQTT_BASE_TOPIC=warehouse/site1/lwb
MQTT_BATCH_SIZE=50
MQTT_IDLE_SEC=0.5

# Rows older than this are not sent (kept in SQLite). 0 = send everything.
PUBLISH_MAX_AGE_HOURS=24
# Retained status message: UART ok/bad %, backlog
GATEWAY_STATUS_SEC=15
# How often lwb_gateway logs the UART ok/bad counters
UART_STATS_SEC=60
