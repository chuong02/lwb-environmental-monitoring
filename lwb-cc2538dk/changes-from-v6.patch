+static void packet_init(up_packet_t *p, uint8_t type, uint16_t seq)
+{
+  memset(p, 0, sizeof(*p));
+  p->magic = UP_MAGIC; p->version = UP_VERSION; p->type = type;
+  p->run = UP_RUN_ID; p->source = node_id; p->seq = seq;
